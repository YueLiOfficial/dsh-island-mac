{
  "name": "dsh-island-mac",
  "version": "0.5.0",
  "description": "在 macOS 刘海/灵动岛区域显示当前 dsh 任务的完成百分比",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "macos",
    "notch",
    "dynamic-island"
  ],
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "bin",
    "THIRD_PARTY_NOTICES.md",
    "docs/RELEASE-v0.5.0.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bash scripts/build-bundle.sh",
    "prepack": "bash scripts/build-bundle.sh",
    "verify:package": "bash scripts/verify-packed-tarball.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
